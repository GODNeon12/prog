{
  "version": 2,
  "public": true,
  "output": "static",
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://YOUR_BACKEND_URL/api/$1",
      "continue": true
    },
    {
      "src": "(.*)",
      "dest": "frontend/$1"
    }
  ]
}
